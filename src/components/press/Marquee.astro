---
interface Props {
  press: string[];
}

const { press } = Astro.props;
const itemsA = [...press, ...press, ...press];
const itemsB = [...press, ...press, ...press].reverse();
---

<section class="overflow-hidden border-y-2 border-ghost/10 bg-ink">
  <div class="overflow-hidden border-b border-ghost/10 py-4">
    <div class="marquee-track flex w-max">
      {itemsA.map((p) => (
        <span class="font-display chrom-soft mx-6 text-3xl uppercase tracking-tight text-ghost sm:text-5xl">
          {p}
          <span class="mx-6 text-magenta">◉</span>
        </span>
      ))}
    </div>
  </div>
  <div class="overflow-hidden py-4">
    <div class="marquee-track-rev flex w-max">
      {itemsB.map((p) => (
        <span class="mx-6 font-mono text-base font-bold uppercase tracking-[0.3em] text-cyan sm:text-xl">
          {p}
          <span class="mx-6 text-acid">▲</span>
        </span>
      ))}
    </div>
  </div>
</section>
