---
import Layout from "../layouts/Layout.astro";
import kav from "../content/artists/kav.json";
import bailey from "../content/artists/bailey-holmes.json";
import charlie from "../content/artists/charlie-choppa.json";

const roster = [
  { ...kav, url: "/kav", tilt: "card-tilt-1" },
  { ...bailey, url: "/bailey-holmes", tilt: "card-tilt-2" },
  { ...charlie, url: "/charlie-choppa", tilt: "card-tilt-3" },
];

const totalCombinedStreams = roster.reduce((sum, a) => sum + (a.stats.totalStreams || 0), 0);
const totalDisplay = (totalCombinedStreams / 1000000).toFixed(0) + "M+";
const year = new Date().getFullYear();

// Marquee strings
const tickerA = ["BASSLINE FREQUENCY", "WEST YORKSHIRE UK", "138 BPM", "PIRATE RADIO ⚡", "ON AIR", "TUNE IN"];
const tickerB = roster.map(r => `${r.name.toUpperCase()} · ${r.stats.totalStreamsDisplay} STREAMS`);
---

<Layout
  title="Bradford Bassline — The roster"
  description="The West Yorkshire bassline crew. KAV, Bailey Holmes, Charlie Choppa — 40M+ streams between them."
  canonical="/"
>
  <main class="min-h-screen bg-ink">
    <!-- TOP TICKER (magenta) -->
    <div class="overflow-hidden border-b border-ghost/10 bg-ink py-3">
      <div class="marquee-track flex w-max">
        {[...tickerA, ...tickerA, ...tickerA, ...tickerA].map((s) => (
          <span class="mx-6 font-mono text-sm font-bold uppercase tracking-[0.3em] text-magenta">
            {s} <span class="ml-6 text-ghost/30">◉</span>
          </span>
        ))}
      </div>
    </div>

    <!-- HERO ZONE -->
    <section class="relative overflow-hidden border-b border-ghost/10 px-6 py-24 sm:px-16 sm:py-32 lg:py-40">
      <!-- Backdrop: huge transparent BB monogram -->
      <div
        class="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 select-none font-display text-[40vw] font-black uppercase leading-none text-ghost/[0.03] sm:text-[30vw]"
        style="letter-spacing:-0.06em; line-height:0.8;"
        aria-hidden="true"
      >
        BB
      </div>

      <!-- LIVE indicator top-right -->
      <div class="absolute right-6 top-6 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.3em] text-acid sm:right-10 sm:top-10">
        <span class="live-dot inline-block h-2 w-2 rounded-full bg-acid" />
        ON AIR · {roster.length} ARTISTS · {totalDisplay} STREAMS
      </div>

      <div class="relative mx-auto max-w-7xl">
        <div class="font-mono text-[11px] font-bold uppercase tracking-[0.4em] text-cyan">
          <span class="bg-cyan px-2 py-1 text-ink">▶</span>
          <span class="ml-3">PRESENTING · THE ROSTER</span>
        </div>

        <h1
          class="font-display mt-8 text-[20vw] uppercase leading-[0.8] text-ghost sm:text-[14vw] lg:text-[12vw]"
          style="letter-spacing:-0.05em; text-shadow: 0 6px 32px rgba(10,6,18,0.7);"
        >
          BRADFORD<br/>
          <span class="text-magenta">BASSLINE.</span>
        </h1>

        <div class="mt-10 flex flex-wrap items-center gap-3 sm:gap-4">
          <span class="sticker px-4 py-2 text-xs">▼ TUNE IN</span>
          <span class="border border-cyan/60 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.3em] text-cyan" style="background:rgba(0,245,255,0.06);">
            ⏵ WEST YORKSHIRE · 138 BPM
          </span>
          <span class="border border-magenta/60 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.3em] text-magenta" style="background:rgba(255,0,122,0.06);">
            ◉ PIRATE FREQUENCY
          </span>
        </div>

        <p class="mt-10 max-w-2xl text-base leading-relaxed text-ghost/70 sm:text-lg">
          Three independent artists, one sound. <strong class="text-ghost">KAV</strong> out of Leeds,
          <strong class="text-ghost">Bailey Holmes</strong> + <strong class="text-ghost">Charlie Choppa</strong> from Bradford.
          {totalDisplay} streams across the crew.
        </p>
      </div>
    </section>

    <!-- TICKER between hero and cards (cyan, opposite direction) -->
    <div class="overflow-hidden border-b border-ghost/10 bg-ink-soft py-3">
      <div class="marquee-track-rev flex w-max">
        {[...tickerB, ...tickerB, ...tickerB].map((s) => (
          <span class="mx-6 font-mono text-sm font-bold uppercase tracking-[0.3em] text-cyan">
            {s} <span class="ml-6 text-ghost/30">▲</span>
          </span>
        ))}
      </div>
    </div>

    <!-- ARTIST CARDS — stacked, tilted, sticker-style -->
    <section class="px-6 py-24 sm:px-16 sm:py-32">
      <div class="mx-auto max-w-6xl">
        <div class="font-mono text-[11px] font-bold uppercase tracking-[0.4em] text-magenta">
          // THE CREW · {roster.length} ARTISTS
        </div>
        <h2 class="font-display chrom-soft mt-4 text-5xl uppercase leading-none text-ghost sm:text-7xl">
          Pick a frequency.
        </h2>

        <div class="mt-16 grid gap-12 sm:gap-16 lg:grid-cols-3">
          {roster.map((artist, i) => {
            const cityShort = artist.city.split(",")[0];
            const totalDisp = artist.stats.totalStreamsDisplay
              || (artist.stats.totalStreams >= 1000000
                ? Math.round(artist.stats.totalStreams / 100000) / 10 + "M+"
                : artist.stats.totalStreams.toLocaleString("en-GB"));
            const topTrack = artist.topTracks[0];
            const poster = artist.videos && artist.videos[0] ? artist.videos[0].poster : null;
            const number = String(i + 1).padStart(2, "0");
            return (
              <a href={artist.url} class={`group relative block ${artist.tilt}`}>
                <div
                  class="relative overflow-hidden border-2 border-ghost/15 bg-ink-soft transition-all duration-500 group-hover:border-magenta"
                  style="box-shadow: 0 12px 40px rgba(0,0,0,0.5);"
                >
                  <!-- Poster background -->
                  {poster && (
                    <div
                      class="absolute inset-0 bg-cover bg-center opacity-30 transition-opacity duration-500 group-hover:opacity-50"
                      style={`background-image: url(${poster});`}
                    />
                  )}
                  <div
                    class="absolute inset-0"
                    style="background: linear-gradient(180deg, rgba(10,6,18,0.5) 0%, rgba(10,6,18,0.95) 80%);"
                  />

                  <!-- Card content -->
                  <div class="relative z-10 p-6 sm:p-8">
                    <div class="flex items-center justify-between">
                      <span class="sticker px-2.5 py-1 text-[10px]">№ {number}</span>
                      <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-cyan">
                        FM {artist.areaCode}
                      </span>
                    </div>

                    <h3
                      class="font-display chrom-soft mt-8 text-5xl uppercase leading-[0.85] text-ghost transition-colors group-hover:text-magenta sm:text-6xl"
                      style="letter-spacing:-0.04em;"
                    >
                      {artist.name}
                    </h3>

                    <p class="mt-4 max-w-xs text-sm text-ghost/60">{artist.tagline}</p>

                    <!-- Stats row -->
                    <div class="mt-8 grid grid-cols-2 gap-3 border-t border-ghost/10 pt-5 font-mono text-[10px] uppercase tracking-[0.25em] text-ghost/50">
                      <div>
                        <div class="text-magenta">STREAMS</div>
                        <div class="mt-1 text-base font-bold tracking-tight text-ghost">{totalDisp}</div>
                      </div>
                      <div>
                        <div class="text-cyan">MONTHLY</div>
                        <div class="mt-1 text-base font-bold tracking-tight text-ghost">
                          {(artist.stats.monthlyListeners / 1000).toFixed(0)}k
                        </div>
                      </div>
                    </div>

                    {topTrack && (
                      <div class="mt-6 border-t border-ghost/10 pt-5 font-mono text-[10px] uppercase tracking-[0.25em] text-ghost/40">
                        <span class="text-acid">▶ TOP CUT</span><br/>
                        <span class="mt-1 inline-block text-sm font-bold tracking-normal text-ghost">{topTrack.title}</span>
                      </div>
                    )}

                    <div class="mt-8 inline-flex items-center gap-2 border border-magenta/60 px-4 py-2 font-mono text-[10px] font-bold uppercase tracking-[0.3em] text-magenta transition-all group-hover:bg-magenta group-hover:text-ink">
                      ⏵ Open hub
                    </div>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- BOTTOM TICKER (acid yellow) -->
    <div class="overflow-hidden border-y border-ghost/10 bg-ink py-3">
      <div class="marquee-track flex w-max">
        {[...tickerA, ...tickerA].map((s) => (
          <span class="mx-6 font-mono text-sm font-bold uppercase tracking-[0.3em] text-acid">
            {s} <span class="ml-6 text-ghost/30">◉</span>
          </span>
        ))}
      </div>
    </div>

    <!-- FOOTER -->
    <footer class="px-6 py-16 sm:px-10">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <div class="font-mono text-[10px] uppercase tracking-[0.4em] text-ghost/40">
              // built by
            </div>
            <a
              href="https://obholz-solutions.de"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex items-center gap-3 transition-opacity hover:opacity-70"
              aria-label="OBHOLZ SOLUTIONS"
            >
              <img src="/obholz-logo-white.svg" alt="OBHOLZ SOLUTIONS" width="48" height="48" class="h-12 w-12 opacity-90" loading="lazy" />
              <span class="font-display text-lg uppercase leading-none tracking-tight text-ghost sm:text-xl">
                OBHOLZ<br/>SOLUTIONS
              </span>
            </a>
            <p class="mt-3 max-w-xs font-mono text-[10px] uppercase tracking-[0.25em] text-ghost/40">
              Independent fan tribute. No affiliation with the artists or any label.
            </p>
          </div>
          <div class="flex flex-col gap-3 text-right font-mono text-[10px] uppercase tracking-[0.3em] text-ghost/50 sm:items-end">
            <div class="flex flex-wrap justify-end gap-x-6 gap-y-2">
              <a href="/impressum" class="transition-colors hover:text-magenta">Impressum</a>
              <a href="/datenschutz" class="transition-colors hover:text-magenta">Datenschutz</a>
            </div>
            <div class="text-ghost/40">© {year} The roster — site © OBHOLZ SOLUTIONS</div>
          </div>
        </div>
      </div>
    </footer>
  </main>
</Layout>
